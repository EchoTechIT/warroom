# Copy to .env and fill in only what you use:  cp .env.example .env
#
# Subscription seats (architect/adversary) need NO keys here — they use the
# Claude Code / Codex CLIs' own logged-in sessions. Warroom stores no seat creds.
#
# Only the METERED 4th slot (cloud_api variant) needs a key:
DEEPSEEK_API_KEY=

# Optional: point the local/second-GPU seats at non-default hosts by editing
# operators.yaml `http.base_url` instead of env vars.
